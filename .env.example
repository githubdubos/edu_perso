# Jira Cloud / Server connection (never commit real values)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-atlassian-api-token
# Create target: ATL project under epic ATL-25692 (verified: Task works)
# Note: many existing backlog children are RAY Stories; new tickets default to ATL.
JIRA_PROJECT_KEY=ATL
JIRA_ISSUE_TYPE=Story
# Parent epic used for sample fetch + create linkage (parent field)
JIRA_PARENT_KEY=ATL-25692
# How many recent child tickets to send to the LLM as style samples (1-20)
JIRA_SAMPLE_LIMIT=8
# Atlassian Team field (customfield_10001). UI shows the name; create sends the id.
# Defaults match epic ATL-25692 (BC.RCOFit+LR). Leave empty in the form to omit Team.
JIRA_TEAM_NAME=BC.RCOFit+LR
JIRA_TEAM_ID=7ed41a1b-0081-46cd-b045-228ee9e6d8b4-7

# --- Customer Jira site (read-only, used by the "Client ticket" field) ---
# Customer tickets live on a different Atlassian site than the ATL development
# project. Atlassian API tokens are account-scoped, not site-scoped, so the
# credentials above usually work here; override only if the account differs.
CLIENT_JIRA_BASE_URL=https://regnology-cloud.atlassian.net
# CLIENT_JIRA_EMAIL=you@example.com
# CLIENT_JIRA_API_TOKEN=your-atlassian-api-token

# --- Suggest with AI ---
# Default provider is Cursor (this app calls the Cursor agent via cursor-sdk).
# Optional fallbacks: gemini | openai | azure
SUGGEST_PROVIDER=cursor

# Cursor agent (preferred)
# Create a user API key: https://cursor.com/dashboard/integrations
CURSOR_API_KEY=
# Model id for the Cursor SDK (default composer-2.5)
CURSOR_MODEL=composer-2.5
# local = run on this machine against the repo; cloud = Cursor-hosted VM (no-repo)
CURSOR_RUNTIME=local
# Max seconds to wait in Automations/file-bridge mode (SDK waits on the agent run)
CURSOR_SUGGEST_TIMEOUT_SECONDS=120
# Optional: Cursor Automations webhook URL (used only when CURSOR_API_KEY is empty)
# CURSOR_SUGGEST_WEBHOOK_URL=https://...

# Classic LLM fallbacks (only when SUGGEST_PROVIDER=gemini|openai|azure)
# LLM_PROVIDER=openai
# LLM_PROVIDER=azure
# LLM_PROVIDER=gemini

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Gemini (Google AI Studio / Gemini Developer API)
# Create a key at https://aistudio.google.com/app/api-keys
# GOOGLE_API_KEY is accepted as an alias for GEMINI_API_KEY
GEMINI_API_KEY=
# GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional: HTTP server bind (defaults shown)
# HOST=127.0.0.1
# PORT=8000
